          "id": "de8ff091-dab8-4855-8e84-cd1f9205cc79",
          "areas": [
            {
              "grid": "6",
              "controls": [
                {
                  "value": "<p>Sie möchten mehr erfahren oder direkt in Kontakt treten?<br>Dann schreiben Sie mir per Post:</p>\n<p><strong>Dirk Seefeld<br></strong>Hoherade 18<br>D-20257 Hamburg</p>\n<p><em><strong>Social Links:</strong></em></p>",
                  "editor": {
                    "alias": "rte",
                    "view": "rte"
                  },
                  "styles": null,
                  "config": null
                },
                {
                  "value": {
                    "macroAlias": "mastodonLink",
                    "macroParamsDictionary": {
                      "profileName": "dseefeld",
                      "mastodonServer": "umbracocommunity.social",
                      "useWordmark": "1"
                    }
                  },
                  "editor": {
                    "alias": "macro",
                    "view": "macro"
                  },
                  "styles": null,
                  "config": null
                },
                {
                  "value": {
                    "macroAlias": "LinkedInLink",
                    "macroParamsDictionary": {
                      "profileName": "dirk-seefeld-62010b23"
                    }
                  },
                  "editor": {
                    "alias": "macro",
                    "view": "macro"
                  },
                  "styles": null,
                  "config": null
                }
              ],
              "styles": null,
              "config": null
            },
            {
              "grid": "6",
              "controls": [
                {
                  "value": "<p>oder senden Sie mir eine Nachricht über das folgende Kontaktformular:</p>",
                  "editor": {
                    "alias": "rte",
                    "view": "rte"
                  },
                  "styles": null,
