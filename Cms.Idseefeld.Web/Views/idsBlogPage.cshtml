@inherits Umbraco.Cms.Web.Common.Views.UmbracoViewPage<IdsBlogPage>
@using ContentModels = Umbraco.Cms.Web.Common.PublishedModels;
@inject IPublishedSnapshotAccessor _snapshotAccessor;
@{
    Layout = "IdsMaster.cshtml";
    var mainGridAlias = IdsBlogPage.GetModelPropertyType(_snapshotAccessor, p => p.MainGrid)?.Alias;
    var goToOverview = Umbraco.GetDictionaryValue("goToOverview", "zur Übersicht");
    var cssClass = "container blogs";
    var overviewUrl = Model.Parent?.Url();
}
<div class="@cssClass">
    @if (mainGridAlias != null)
    {
        <div class="row">

            <div class="col-lg-9">
                @Html.GetGridHtml(Model, mainGridAlias, "bootstrap3")
            </div>

            <div class="col-lg-3">
                <a href="@overviewUrl">@goToOverview</a>
            </div>

        </div>
    }
</div>