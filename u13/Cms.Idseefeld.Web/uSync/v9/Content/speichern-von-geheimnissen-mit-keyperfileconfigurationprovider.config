            {
              "grid": "12",
              "controls": [
                {
                  "value": "<p> </p>\n<p>You can read more about the details here: <a rel=\"noopener\" href=\"https://learn.microsoft.com/en-us/aspnet/core/fundamentals/configuration/?view=aspnetcore-6.0#key-per-file-configuration-provider\" target=\"_blank\">https://learn.microsoft.com/en-us/aspnet/core/fundamentals/configuration/?view=aspnetcore-6.0#key-per-file-configuration-provider</a></p>",
