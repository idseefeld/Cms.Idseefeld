@inherits Umbraco.Cms.Web.Common.Views.UmbracoViewPage<IdsBlogsOverviewPage>
@using Cms.Idseefeld.Core.Services;
@using ContentModels = Umbraco.Cms.Web.Common.PublishedModels;
@inject IPublishedSnapshotAccessor _snapshotAccessor;
@{
    Layout = "IdsMaster.cshtml";
    var noBlogs = Umbraco.GetDictionaryValue("noBlogs", "Es gibt noch keine Blogbeiträge.");
    var readMore = Umbraco.GetDictionaryValue("readMoreLabel", "mehr lesen...");
    var lastUpdated = Umbraco.GetDictionaryValue("lastUpdated", "zuletzt aktualisiert am");
    var blogs = BlogService.GetBlogs(Umbraco, Model);

    var useCardStyle = Model.UseCardStyle;
    var extraCssClass = useCardStyle ? "" : "col-lg-9";
    var showFilter = false;
}
<div class="container blogs">
    <div class="row">
        @if (blogs.Any())
        {
            <div class="col-12 @extraCssClass p-0">
                <div class="container">
                    <div class="row">
                        @foreach (var blog in blogs)
                        {
                            if (useCardStyle)
                            {
                                @await Html.PartialAsync("ids/ids-Blog-Card", blog)
                            }
                            else
                            {
                                @await Html.PartialAsync("ids/ids-Blog-ListItem", blog)
                            }
                        }
                    </div>
                </div>
            </div>
            @if (!useCardStyle && showFilter)
            {
                <div class="col-lg-3">
                    <form method="get">
                        <input name="filter" class="form-control" placeholder="Filtern nach...">
                    </form>
                </div>
            }
        }
        else
        {
            <p>@noBlogs</p>
        }
    </div>
</div>

