@inherits Umbraco.Cms.Web.Common.Macros.PartialViewMacroPage
@{
    var lang = System.Threading.Thread.CurrentThread.CurrentCulture.TwoLetterISOLanguageName;
    var dataLocale = lang == "de" ? "de_DE" : "en_US";
    var prefix = lang == "de" ? "de." : "en.";

    var isBackoffice = (Context?.Request?.RouteValues["action"]?.ToString() ?? "").InvariantEquals("GetMacroResultAsHtmlForEditor");
    var profileName = Model?.MacroParameters["profileName"]?.ToString();
}
@if (isBackoffice)
{
    <h4>LinkedIn Link</h4>
    <p>
        Profile:<br /><strong>@profileName</strong>
    </p>
}
else if (!string.IsNullOrWhiteSpace(profileName))
{
    <div class="badge-base LI-profile-badge" data-locale="@dataLocale" data-size="medium" data-theme="light" data-type="VERTICAL" data-vanity="@profileName" data-version="v1"><a class="badge-base__link LI-simple-link" href="https://@(prefix)linkedin.com/in/@profileName?trk=profile-badge"></a></div>
}