{
  "$schema": "appsettings-schema.json",
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information"
    },
    "WriteTo": [
      {
        "Name": "Async",
        "Args": {
          "configure": [
            {
              "Name": "Console"
            }
          ]
        }
      }
    ]
  },
  "Umbraco": {
    "CMS": {
      "Global": {
        "Smtp": {
          "From": "noreply@idseefeld.de",
          "Host": "localhost",
          "Port": 25,
          "Username": "",
          "SecureSocketOptions": "Auto"
        }
      },
      "Content": {
        "MacroErrors": "Throw"
      },
      "Hosting": {
        "Debug": false
      },
      "ModelsBuilder": {
        "AcceptUnsafeModelsDirectory": true,
        "ModelsDirectory": "~/../Cms.Idseefeld.Core/Models/Generated",
        "ModelsMode": "SourceCodeManual"
      },
      "RuntimeMinification": {
        "UseInMemoryCache": true,
        "CacheBuster": "Timestamp"
      },
      "Runtime": {
        "Mode": "Development"
      },
      "WebRouting": {
        "UmbracoApplicationUrl": "https://localhost:44317"
      }
    },
    "Unattended": {
      "UpgradeUnattended": true,
      "InstallUnattended": true,
      "UnattendedUserName": "admin",
      "UnattendedUserEmail": "admin@example.com",
      "UnattendedUserPassword": "1234567890"
    }
  }
}
