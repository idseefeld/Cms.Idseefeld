   target="_blank"
   rel="noopener"
   class="profile-link call-to-action">
    <img src="~/css/linkedin-icon.svg" alt="" class="linkedin-icon">
    <span>Profil auf LinkedIn ansehen</span>
</a>
 *@

    
<div class="call-to-action linkedin-link" onclick="window.open('https://www.linkedin.com/in/@(profileName)/', '_blank')">
    <button title="Profil von Dirk Seefeld auf www.linkedin.com">
        <img src="~/css/linkedin-icon.svg" alt="" class="linkedin-icon">
        <span>Profil auf LinkedIn ansehen</span>
    </button>
</div>