@inherits Umbraco.Cms.Web.Common.Views.UmbracoViewPage<ImageCropViewModel>
@using ContentModels = Umbraco.Cms.Web.Common.PublishedModels;
@{
    var alt = Model?.Alt;
    var src = Model?.CropperValue?.Src;
    var firstCrop = Model?.CropperValue?.Crops?.FirstOrDefault();    
    var cropAlias = firstCrop?.Alias ?? string.Empty;
    var src465 = src?.GetCropUrl(cropAlias: cropAlias, width: 465);
    var src650 = src?.GetCropUrl(cropAlias: cropAlias, width: 650);
    var srcMax = src?.GetCropUrl(cropAlias: cropAlias, width: 1200);
}
@if (!string.IsNullOrEmpty(src))
{
    <picture>
        <source media="(min-width:650px)" srcset="@src650">
        <source media="(min-width:465px)" srcset="@src465">
        <img src="@srcMax" alt="@alt" />
    </picture>
    <br />
    @if (!string.IsNullOrEmpty(Model?.Caption))
    {
        <small class="image caption">@Model.Caption</small>
    }
}