        {
          "alias": "richText",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": {
            "blocks": {
              "contentData": [],
              "settingsData": [],
              "expose": [],
              "layout": {}
            },
            "markup": "\u003Cp\u003ESie m\u00F6chten mehr erfahren oder direkt in Kontakt treten?\u003Cbr\u003EDann schreiben Sie mir per Post:\u003C/p\u003E\n\u003Cp\u003E\u003Cstrong\u003EDirk Seefeld\u003Cbr\u003E\u003C/strong\u003EHoherade 18\u003Cbr\u003ED-20257 Hamburg\u003C/p\u003E\n\u003Cp\u003E\u003Cem\u003E\u003Cstrong\u003ESocial Links:\u003C/strong\u003E\u003C/em\u003E\u003C/p\u003E\n\u003Cp\u003E\u00A0\u003C/p\u003E\n\u003C?UMBRACO_MACRO macroAlias=\u0022mastodonLink\u0022 profileName=\u0022dseefeld\u0022 mastodonServer=\u0022umbracocommunity.social\u0022 useWordmark=\u00221\u0022 /\u003E\n\u003Cp\u003E\u00A0\u003C/p\u003E\n\u003C?UMBRACO_MACRO macroAlias=\u0022LinkedInLink\u0022 profileName=\u0022dirk-seefeld-62010b23\u0022 /\u003E\n\u003Cp\u003E\u00A0\u003C/p\u003E\n\u003Cp\u003E\u00A0\u003C/p\u003E"
          }
        }
      ]
    },
    {
      "contentTypeKey": "c8e87d5c-7810-4cd1-ae93-2452620fda85",
      "key": "f52c7bb5-5a30-45a0-a940-e62578ffaacb",
      "values": [
        {
          "alias": "richText",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": {
            "blocks": {
              "contentData": [],
              "settingsData": [],
              "expose": [],
              "layout": {}
            },
            "markup": "\u003Cp\u003Eoder senden Sie mir eine Nachricht \u00FCber das folgende Kontaktformular:\u003C/p\u003E\n\u003Cp\u003E\u00A0\u003C/p\u003E\n\u003C?UMBRACO_MACRO macroAlias=\u0022ContactForm\u0022 /\u003E\n\u003Cp\u003E\u00A0\u003C/p\u003E"
          }
        }
      ]
