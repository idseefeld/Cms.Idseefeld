    <blockGrid>
      <Value><![CDATA[{
  "contentData": [
    {
      "contentTypeKey": "998f0593-ccb3-47bb-bd75-cd1e7e4dcb8d",
      "key": "87923d9e-4908-4c5f-aac2-ab34932b8b28",
      "values": [
        {
          "alias": "image",
