<Project Sdk="Microsoft.NET.Sdk.Razor">

	<PropertyGroup>
		<TargetFramework>net6.0</TargetFramework>
		<Nullable>enable</Nullable>
		<ImplicitUsings>enable</ImplicitUsings>
		<AddRazorSupportForMvc>true</AddRazorSupportForMvc>
		<StaticWebAssetBasePath>App_Plugins</StaticWebAssetBasePath>
		<ContentTargetFolders>.</ContentTargetFolders>
		<GeneratePackageOnBuild>True</GeneratePackageOnBuild>
		<Title>GridImageCropPackage</Title>
		<Authors>dseefeld</Authors>
		<Description>A grid editor that allows you to chose a named crop of an image.</Description>
		<Copyright>$([System.DateTime]::UtcNow.ToString(`yyyy`)) © $(authors)</Copyright>
		<Version>2.0.0</Version>
		<Product>Grid Image Crop</Product>
		<PackageProjectUrl>https://github.com/idseefeld/Cms.idseefeld</PackageProjectUrl>
		<PackageReadmeFile>readme.md</PackageReadmeFile>
		<RepositoryType>git</RepositoryType>
		<PackageTags>umbraco;umbraco-marketplace</PackageTags>
		<PackageLicenseExpression>MIT</PackageLicenseExpression>
		<AssemblyVersion>2.0.0</AssemblyVersion>
		<FileVersion>2.0.0</FileVersion>
		<IncludeSymbols>True</IncludeSymbols>
		<PackageRequireLicenseAcceptance>True</PackageRequireLicenseAcceptance>
		<SymbolPackageFormat>snupkg</SymbolPackageFormat>
	</PropertyGroup>

	<ItemGroup>
	  <Compile Remove="Extensions\**" />
	  <Compile Remove="Views\**" />
	  <Content Remove="Extensions\**" />
	  <Content Remove="Views\**" />
	  <EmbeddedResource Remove="Extensions\**" />
	  <EmbeddedResource Remove="Views\**" />
	  <None Remove="Extensions\**" />
	  <None Remove="Views\**" />
	</ItemGroup>

	<ItemGroup>
	  <Content Remove="umbraco-marketplace.json" />
	  <Content Remove="wwwroot\GridImageCrop\ImageCrop.cshtml" />
	</ItemGroup>

	<ItemGroup>
	  <None Remove="LICENSE" />
	</ItemGroup>

	<ItemGroup>
		<FrameworkReference Include="Microsoft.AspNetCore.App" />
	</ItemGroup>

	<ItemGroup>
	  <PackageReference Include="Umbraco.Cms.Web.BackOffice" Version="10.8.3" />
	  <PackageReference Include="Umbraco.Cms.Web.Website" Version="10.8.3" />
	</ItemGroup>

	<ItemGroup>
	  <Content Update="wwwroot\GridImageCrop\imageCrop.css">
	    <CopyToOutputDirectory>Never</CopyToOutputDirectory>
	  </Content>
	  <Content Update="wwwroot\GridImageCrop\imageCropGridEditor.controller.js">
	    <CopyToOutputDirectory>Never</CopyToOutputDirectory>
	  </Content>
	  <Content Update="wwwroot\GridImageCrop\imageCropGridEditor.html">
	    <CopyToOutputDirectory>Never</CopyToOutputDirectory>
	  </Content>
	  <Content Update="wwwroot\GridImageCrop\mediapicker.controller.js">
	    <CopyToOutputDirectory>Never</CopyToOutputDirectory>
	  </Content>
	  <Content Update="wwwroot\GridImageCrop\mediapicker.html">
	    <CopyToOutputDirectory>Never</CopyToOutputDirectory>
	  </Content>
	  <Content Update="wwwroot\GridImageCrop\overlays\mediacropdetails.controller.js">
	    <CopyToOutputDirectory>Never</CopyToOutputDirectory>
	  </Content>
	  <Content Update="wwwroot\GridImageCrop\overlays\mediacropdetails.html">
	    <CopyToOutputDirectory>Never</CopyToOutputDirectory>
	  </Content>
	</ItemGroup>

	<ItemGroup>
	  <None Update="readme.md">
	    <Pack>True</Pack>
	    <PackagePath>\</PackagePath>
	  </None>
	</ItemGroup>



</Project>
