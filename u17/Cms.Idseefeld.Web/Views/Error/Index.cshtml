@{
    var lang = System.Threading.Thread.CurrentThread.CurrentCulture.TwoLetterISOLanguageName.ToLower();
    var isDE = lang == "de";
    var title = isDE  ? "Fehler" : "Error";
}
<!DOCTYPE html>
<html>
    <head>
        <title>@title</title>
    </head>
    <body>
        @if(isDE){
            <h1>Fehler</h1>
            <p>
                Es ist ein unbekannter Feher aufgetreten. Bitte versuchen Sie es später erneut.
            </p>
        }else{
            <h1>Error</h1>
            <p>An unknown error occured. Please try again later.</p>
        }
    </body>
</html>