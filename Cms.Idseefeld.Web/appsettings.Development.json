{
  "$schema": "./appsettings-schema.json",
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information"
    },
    "WriteTo": [
      {
        "Name": "Async",
        "Args": {
          "configure": [
            {
              "Name": "Console"
            }
          ]
        }
      }
    ]
  },
  "ConnectionStrings": {
    "umbracoDbDSN": "Server=.\\sql2019;Database=cms.idseefeld;User Id=cms.idseefeld;Password=cms.idseefeld",
    "umbracoDbDSN_ProviderName": "Microsoft.Data.SqlClient"
  },
  "Umbraco": {
    "CMS": {
      "Runtime": {
        "Mode": "Development"
      },
      "Content": {
        "MacroErrors": "Throw"
      },
      "ModelsBuilder": {
        "AcceptUnsafeModelsDirectory": true,
        "ModelsDirectory": "~/../Cms.Idseefeld.Core/Models/Generated",
        "ModelsMode": "SourceCodeManual"
      },
      "Hosting": {
        "Debug": true
      },
      "Global": {
        "Smtp": {
          "From": "no-replay@idseefeld.de",
          "Host": "localhost",
          "Password": "",
          "Port": 25,
          "Username": "",
          "SecureSocketOptions": "None"
        }
      },
      "RuntimeMinification": {
        "UseInMemoryCache": true,
        "CacheBuster": "Timestamp"
      }
    }
  }
}
