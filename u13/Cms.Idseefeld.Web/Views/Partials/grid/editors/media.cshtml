@model dynamic
@using Umbraco.Cms.Core.Media
@using Umbraco.Cms.Core.PropertyEditors.ValueConverters
@inject IImageUrlGenerator ImageUrlGenerator

@if (Model?.value is not null)
{
    var url = Model.value.image;

    var altText = Model.value.altText ?? Model.value.caption ?? string.Empty;
    var src = ImageCropperTemplateCoreExtensions.GetCropUrl((string)url, ImageUrlGenerator, width: 1400, imageCropMode: ImageCropMode.Min);
    var imgSrc576 = ImageCropperTemplateCoreExtensions.GetCropUrl((string)url, ImageUrlGenerator, width: 576, imageCropMode: ImageCropMode.Min);
    var imgSrc768 = ImageCropperTemplateCoreExtensions.GetCropUrl((string)url, ImageUrlGenerator, width: 768, imageCropMode: ImageCropMode.Min);
    var imgSrc992 = ImageCropperTemplateCoreExtensions.GetCropUrl((string)url, ImageUrlGenerator, width: 831, imageCropMode: ImageCropMode.Min); // max possible width is 831px

    <picture class="noscript hidden" onclick="showImageBox(event, '@url','@altText','@Model.value.caption')">
        <source media="(max-width:576)" srcset="@imgSrc576">
        <source media="(max-width:768px)" srcset="@imgSrc768">
        <source media="(max-width:992px)" srcset="@imgSrc992">
        <img src="@src" alt="@altText" />
    </picture>

    <noscript>
        <a href="@url" accesskey="i" class="image-link" target="_blank" rel="noopener noreferrer">
            <img src="@src" alt="@altText" />
        </a>
    </noscript>

    if (Model.value.caption != null)
    {
        <p class="caption">@Model.value.caption</p>
    }
}
