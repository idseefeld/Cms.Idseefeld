@inherits Umbraco.Cms.Web.Common.Macros.PartialViewMacroPage

@using Microsoft.AspNetCore.Http.Extensions
@using Umbraco.Cms.Core.Security
@using Umbraco.Cms.Web.Common.Models
@using Umbraco.Cms.Web.Website.Controllers
@using Umbraco.Extensions

@inject IMemberManager memberManager

@{
    var identity = Context.User.GetMemberIdentity();
    var isLoggedIn = identity?.IsAuthenticated ?? false;
    if (!isLoggedIn)
    {
        // If the user is not logged in, we don't need to proceed further
        return;
    }

    var isAllowed = await memberManager.IsMemberAuthorizedAsync(allowGroups: ["friends"]);

    var logoutModel = new PostRedirectModel();
    // You can modify this to redirect to a different URL instead of the current one
    logoutModel.RedirectUrl = Model.Content.Url();

    var buttonLabel = Umbraco.GetDictionaryValueOrDefault("Logout", "Log out");

    var showPermissionAlert = Model.MacroParameters["showPermissionAlert"]?.ToString() == "1";
}

@if (isLoggedIn)
{
    <div class="login-status mb-4">

        @using (Html.BeginUmbracoForm<UmbLoginStatusController>("HandleLogout", new { RedirectUrl = logoutModel.RedirectUrl }))
        {
            <button type="submit" class="btn btn-primary">@buttonLabel</button>
        }

    </div>

    @if (isAllowed)
    {
        var privateBlogPage = Model.Content?.Children()?.FirstOrDefault(p => p is IdsBlogsOverviewPage);

        if (privateBlogPage != null)
        {

            <div id="login-macro" class="blogs">

                @await Component.InvokeAsync("BlogListBlogsSidebar", new { umbracoHelper = Umbraco, page = privateBlogPage })

            </div>
        }
    }
    else if (!isAllowed && showPermissionAlert)
    {
        <div class="alert alert-danger" role="alert">
            @Umbraco.GetDictionaryValueOrDefault("NoPrivatePermission", "Sie sind nicht für meinen privaten Bereich zugelassen!")
        </div>
    }
}