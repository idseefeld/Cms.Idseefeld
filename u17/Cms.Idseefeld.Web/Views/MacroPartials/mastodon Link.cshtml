@inherits Umbraco.Cms.Web.Common.Macros.PartialViewMacroPage
@{

    var isBackoffice = (Context?.Request?.RouteValues["action"]?.ToString() ?? "").InvariantEquals("GetMacroResultAsHtmlForEditor");
    var profileName = Model?.MacroParameters["profileName"]?.ToString();
    var mastodonServer = Model?.MacroParameters["mastodonServer"]?.ToString();
    var useWordmarkParam = Model?.MacroParameters["useWordmark"]?.ToString() ?? "0";
    var useWordmark = useWordmarkParam == "1";
    var typeClass = useWordmark ? "wordmark" : "logo";
    var link = $"https://{mastodonServer}/@{profileName}";
    var title = $"{profileName}@{mastodonServer}";
}

@if (isBackoffice)
{
    <h4>mastodon Link</h4>
    <p>
        Profile:<br />
        <strong>@profileName</strong><br />
        on server:<br />
        <strong><em>@mastodonServer</em></strong>

    </p>
    <p>
        as @typeClass
    </p>
}
else if (!string.IsNullOrWhiteSpace(profileName) && !string.IsNullOrWhiteSpace(mastodonServer))
{
    <div class="mastodon">
        <a href="@link" target="_blank" title="@title">
            <div class="@typeClass"></div>
        </a>
    </div>
}