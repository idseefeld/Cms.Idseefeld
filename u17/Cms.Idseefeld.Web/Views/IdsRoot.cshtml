@inherits Umbraco.Cms.Web.Common.Views.UmbracoViewPage<ContentModels.IdsRootPage>
@using ContentModels = Umbraco.Cms.Web.Common.PublishedModels;
@{
    Layout = "IdsMaster.cshtml";
    ViewData["pageCssClass"] = "root";
    var cssClass = "container-fluid";
    var hasMainBlockGrid = Model.BlockGrid?.Count() > 0;
}

<div class="@cssClass">
    @if (hasMainBlockGrid)
    {

        <div class="standard">

            @await Html.GetBlockGridHtmlAsync(Model.BlockGrid)

        </div>
    }

    
</div>

@section TopNavi {
    <!-- kein Menü auf Startseite -->
}