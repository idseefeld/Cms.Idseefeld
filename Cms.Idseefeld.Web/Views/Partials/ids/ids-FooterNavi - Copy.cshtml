@inherits Umbraco.Cms.Web.Common.Views.UmbracoViewPage
@using Umbraco.Cms.Core
@using Umbraco.Cms.Core.Models.PublishedContent
@using Umbraco.Cms.Core.Routing
@using Umbraco.Extensions
@using ContentModels = Umbraco.Cms.Web.Common.PublishedModels;

@inject IPublishedValueFallback PublishedValueFallback
@inject IPublishedUrlProvider PublishedUrlProvider
@inject IPublishedSnapshotAccessor _snapshotAccessor;

@{
    var footerLinksAlias = ContentModels.IdsRootPage.GetModelPropertyType(_snapshotAccessor, p => p.FooterLinks)?.Alias ?? "footerLinks";

    var root = Model?.AncestorOrSelf<IdsRootPage>();
    var hasLinks = root?.HasProperty(footerLinksAlias);
    hasLinks = root?.HasValue(footerLinksAlias);
    var selection = root?.FooterLinks?.ToArray();
    //ToDo: How do I get the localized page names?

    var toggleLabel = Umbraco.GetDictionaryValue("toggleNavigation", "Toggle navigation");
    var lang = System.Threading.Thread.CurrentThread.CurrentCulture.TwoLetterISOLanguageName;
}

@if (selection?.Length > 0)
{

    @*<div class="container">
        <div class="row align-items-center">
            <div class="col-lg-4 text-lg-start">
                <a href="/" class="lang @(lang=="de" ? "selected" : "")">DE</a> |
                <a href="/en" class="lang @(lang=="en" ? "selected" : "")">EN</a>
                <span class="px-1"></span>
                Copyright &copy; Dirk Seefeld @DateTime.Today.Year
            </div>
            <div class="col-lg-4 my-3 my-lg-0">
                <a class="btn btn-dark btn-social mx-2" href="#!" aria-label="Twitter"><i class="fab fa-twitter"></i></a>
                <a class="btn btn-dark btn-social mx-2" href="#!" aria-label="Facebook"><i class="fab fa-facebook-f"></i></a>
                <a class="btn btn-dark btn-social mx-2" href="#!" aria-label="LinkedIn"><i class="fab fa-linkedin-in"></i></a>
            </div>
            <div class="col-lg-4 text-lg-end">
                @for (var i = 0; i < selection.Length; i++)
                {
                    Umbraco.Cms.Core.Models.Link item = selection[i];
                    if (item != null)
                    {
                        var spacingCss = i == selection.Length - 1 ? "" : "me-3";
                        var content = item.Udi == null ? null : Umbraco.Content(item.Udi);
                        var name = content?.Name ?? item.Name;
                        var url = item.Url;
                        var isActive = url?.Equals(Model?.Url(PublishedUrlProvider)) ?? false;
                        if (isActive)
                        {
                            <a class="nav-dark text-decoration-none @spacingCss active" aria-current="page" href="@url">
                                @name
                            </a>
                        }
                        else
                        {
                            <a class="nav-dark text-decoration-none @spacingCss" href="@url">
                                @name
                            </a>
                        }
                    }
                }
            </div>
        </div>
    </div>*@

    <nav class="navbar navbar-expand-lg">
        <div class="container-fluid">
            <span class="-navbar-brand">
                &copy; @DateTime.Today.Year, Dirk Seefeld
                <span class="px-1"></span>
                <a href="/" class="lang @(lang=="de" ? "selected" : "")">DE</a> |
                <a href="/en" class="lang @(lang=="en" ? "selected" : "")">EN</a>
                <span class="px-2"></span>
            </span>
            <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarFooterContent" aria-controls="navbarFooterContent" aria-expanded="false" aria-label="@toggleLabel">
                <span class="navbar-toggler-icon"></span>
            </button>
            <div class="collapse navbar-collapse" id="navbarFooterContent">
                <ul class="navbar-nav me-auto mb-2 mb-lg-0">
                    @foreach (Umbraco.Cms.Core.Models.Link item in selection)
                    {
                        if (item != null)
                        {
                            var content = item.Udi == null ? null : Umbraco.Content(item.Udi);
                            var name = content?.Name ?? item.Name;
                            var url = item.Url;
                            var isActive = url?.Equals(Model?.Url(PublishedUrlProvider)) ?? false;
                            <li class="nav-item">
                                @if (isActive)
                                {
                                    <a class="nav-link active" aria-current="page" href="@url">
                                        @name
                                    </a>
                                }
                                else
                                {
                                    <a class="nav-link" href="@url">
                                        @name
                                    </a>
                                }
                            </li>
                        }
                    }
                </ul>
            </div>
        </div>
    </nav>
}