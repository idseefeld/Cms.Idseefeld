{
  "$schema": "appsettings-schema.json",
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.Hosting.Lifetime": "Information",
        "System": "Warning"
      }
    }
  },
  "ContactMail": {
    "To": "dirk.seefeld@idseefeld.de",
    "ToName": "Dirk Seefeld",
    "UseMailKit": false,
    "MinFormEditingInSeconds": 15
  },
  "DictionaryLocalization": {
    "DataAnnotationOnly": false,
    "DictionaryPrefix": ""
  },
  "Umbraco": {
    "CMS": {
      "Runtime": {
        "Mode": "Production"
      },
      "RuntimeMinification": {
        "UseInMemoryCache": true,
        "CacheBuster": "Version",
        "Version": "250123001"
      },
      "ModelsBuilder": {
        "ModelsMode": "Nothing"
      },
      "Hosting": {
        "Debug": false
      },
      "Global": {
        "Smtp": {
          "From": "noreply@idseefeld.de",
          "Host": "smtp.ionos.de",
          "Port": 465,
          "Username": "noreply@idseefeld.de",
          "SecureSocketOptions": "SslOnConnect"
        },
        "Id": "bd43781f-3f41-47e2-a726-4660986659e9",
        "ReservedPaths": "~/app_plugins/,~/install/,~/mini-profiler-resources/,~/umbraco/,~/error/",
        "UseHttps": true,
        "SanitizeTinyMce": true
      },
      "Content": {
        "Error404Collection": [
          {
            "Culture": "default",
            "ContentKey": "5baec761-98cf-42ff-8540-1c87dc06cbbc"
          }
        ],
        "AllowEditInvariantFromNonDefault": true,
        "ContentVersionCleanupPolicy": {
          "EnableCleanup": true
        }
      },
      "Unattended": {
        "UpgradeUnattended": true
      },
      "Security": {
        "AllowConcurrentLogins": false
      },
      "WebRouting": {
        "UmbracoApplicationUrl": "https://www.idssefeld.de/"
      },
      "RequestHandler": {
        "CharCollection": [
          {
            "Char": "Ä",
            "Replacement": "ae"
          },
          {
            "Char": "Ö",
            "Replacement": "oe"
          },
          {
            "Char": "Ü",
            "Replacement": "ue"
          },
          {
            "Char": "ß",
            "Replacement": "ss"
          },
          {
            "Char": "ä",
            "Replacement": "ae"
          },
          {
            "Char": "ö",
            "Replacement": "oe"
          },
          {
            "Char": "ü",
            "Replacement": "ue"
          }
        ]
      }
    }
  }
}