@using Cms.Idseefeld.Web.Views.Shared.Components;
@model IEnumerable<BlogListBlogsItem>
@{
}

@foreach (var item in Model)
{
    if (item.IsCurrent)
    {
        <div class="mb-3 p-1" style="font-size: 80%; font-weight: 900; opacity: 0.5;">
            <span>@item.Label</span>
        </div>
    }
    else
    {
        <div class="mb-3 p-1 listitem sidebar" onclick="location.href='@item.Url';" style="font-size: 80%; font-weight: 900">
            <span>@item.Label</span>
        </div>
    }
}
