@inherits Umbraco.Cms.Web.Common.Views.UmbracoViewPage<MediaWithCrops>
@using ContentModels = Umbraco.Cms.Web.Common.PublishedModels;
@{
    var alt = Model?.Name;
    var cropAlias = Model?.LocalCrops.Crops?.FirstOrDefault()?.Alias ?? string.Empty;
    var src = Model?.GetCropUrl(width: 1200, cropAlias: cropAlias);
    var src465 = Model?.GetCropUrl(width: 465, cropAlias: cropAlias);
    var src650 = Model?.GetCropUrl(width: 650, cropAlias: cropAlias);
}
@if (!string.IsNullOrEmpty(src))
{
    <picture>
        <source media="(min-width:650px)" srcset="@src650">
        <source media="(min-width:465px)" srcset="@src465">
        <img src="@src" alt="@alt" />
    </picture>
}