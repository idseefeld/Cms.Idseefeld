@using Umbraco.Extensions
@inherits Umbraco.Cms.Web.Common.Views.UmbracoViewPage<Umbraco.Cms.Core.Models.Blocks.BlockGridItem>

@{
    var item = Model.Content as UmbBlockGridDemoImageBlock;
    var src = item?.Image?.MediaUrl();
    int[] sourceSizes = [576, 768, 992];
    int maxSize = 1400;

    if (!string.IsNullOrEmpty(src))
    {
        <picture class="noscript" onclick="showImageBox(event, '@src','@item?.AlternativeText','@item?.AlternativeText')">
            @foreach (var size in sourceSizes)
            {
                <source media="(max-width:@(size)px)" srcset="@src?rmode=min&amp;width=@size">
            }
            <img src="@src?rmode=min&amp;width=@maxSize" alt="@item?.AlternativeText">
        </picture>
    }
    else
    {
        <p>Missing image</p>
    }

    @if (!string.IsNullOrEmpty(item?.Caption))
    {
        <p class="caption">@item.Caption</p>
    }
}
