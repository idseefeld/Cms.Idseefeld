{
  "$schema": "appsettings-schema.json",
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.Hosting.Lifetime": "Information",
        "System": "Warning"
      }
    }
  },
  "ContactMail": {
    "To": "dirk.seefeld@idseefeld.de",
    "ToName": "Dirk Seefeld",
    "MinFormEditingInSeconds": 15
  },
  "DictionaryLocalization": {
    "DataAnnotationOnly": false,
    "DictionaryPrefix": ""
  },
  "Umbraco": {
    "CMS": {
      "Runtime": {
        "Mode": "Production"
      },
      "ModelsBuilder": {
        "ModelsMode": "Nothing"
      },
      "Global": {
        "Smtp": {
          "From": "noreply@idseefeld.de",
          "Host": "smtp.ionos.de",
          "Port": 465,
          "Username": "noreply@idseefeld.de",
          "SecureSocketOptions": "SslOnConnect"
        },
        "Id": "bd43781f-3f41-47e2-a726-4660986659e9",
        "ReservedPaths": "~/app_plugins/,~/install/,~/mini-profiler-resources/,~/umbraco/,~/error/",
        "UseHttps": true,
        "SanitizeTinyMce": true,
        "DefaultLanguage": "de-DE",
        "DefaultUILanguage": "de-DE"
      },
      "Content": {
        "Error404Collection": [
          {
            "Culture": "default",
            "ContentKey": "5baec761-98cf-42ff-8540-1c87dc06cbbc"
          }
        ],
        "AllowEditInvariantFromNonDefault": true,
        "ContentVersionCleanupPolicy": {
          "EnableCleanup": true
        },
        "MacroErrors": "Silent",
        "Notifications": {
          "Email": "no-reply@idseefeld.de"
        }
      },
      "Unattended": {
        "UpgradeUnattended": true
      },
      "Security": {
        "AllowConcurrentLogins": false
      },
      "WebRouting": {
        "UmbracoApplicationUrl": "https://www.idssefeld.de/"
      },
      "RequestHandler": {
        "CharCollection": [
          {
            "Char": "\u00C4",
            "Replacement": "ae"
          },
          {
            "Char": "\u00D6",
            "Replacement": "oe"
          },
          {
            "Char": "\u00DC",
            "Replacement": "ue"
          },
          {
            "Char": "\u00DF",
            "Replacement": "ss"
          },
          {
            "Char": "\u00E4",
            "Replacement": "ae"
          },
          {
            "Char": "\u00F6",
            "Replacement": "oe"
          },
          {
            "Char": "\u00FC",
            "Replacement": "ue"
          }
        ]
      }
    }
  },
  "ConnectionStrings": {
    "umbracoDbDSN_ProviderName": "Microsoft.Data.SqlClient"
  }
}